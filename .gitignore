# Environments
.env
.venv

# Byte-compiled / optimized / DLL files
__pycache__/
# app/__init__.pyc was tracked — 102 bytes of CPython 2.7 bytecode (magic
# 03f3 0d0a), committed before this rule existed.
*.pyc

/knowledge-base

# local synced data
/data
/eval/results*
/eval/*cache.json
/eval/test_set.yaml
/eval/extraction-results*
extraction_truth.yaml

# docs/ is tracked except what runs write. Every pipeline run appends to the
# cost log, so tracking it would leave the tree dirty after every run and mark
# every battery manifest git_dirty. Raw run output carries local paths and
# third-party news text.
/docs/cost-log.jsonl
/docs/cost-log-*.jsonl
/docs/validation/**/*.stdout
/docs/validation/**/*.stderr

# dev cache for trading agent
.fundamentals_cache/
# env backups
.env.bak-*
