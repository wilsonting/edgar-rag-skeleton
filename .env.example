# Copy to `.env` and fill in. `.env` is gitignored; this file is the only
# record in the repository of what it must contain.
#
# Only four variables are hard requirements:
#   LLM_CLAUDE_MODEL, LOOP_MAX_TURNS, MEMO_DIR   — read at import time
#   POSTGRES_DATABASE_URL                        — read on first DB use
# Everything else has a default or is only needed by the leg that uses it.

# ---- Provider credentials ---------------------------------------------
# Provider routing is by model-id prefix (claude-* -> anthropic,
# deepseek* -> deepseek, gpt-*/o1/o3/o4 -> openai), so you only need the
# key for the provider your models actually resolve to. Credentials are
# validated at CLIENT CONSTRUCTION, not at first call — a missing key is a
# config error before any money is spent, not a 401 thirty turns in.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=            # also required for embeddings, whatever serves the LLM roles
FINNHUB_API_KEY=           # company news for the news/sentiment leg

# Set LLM_PROVIDER only to override prefix routing wholesale, e.g.
# LLM_PROVIDER=openai-compatible with LLM_BASE_URL + LLM_API_KEY for a
# gateway whose model ids carry no useful prefix.
# LLM_PROVIDER=
# LLM_BASE_URL=
# LLM_API_KEY=

# Correct or add token pricing without a code change. Merged over the
# built-in table; a malformed value raises at import rather than leaving a
# stale rate in place, because a mispriced model makes the per-run budget
# assertion silently unable to fire.
# LLM_PRICING_OVERRIDES='{"deepseek-v4-flash":{"input":0.44,"output":1.32,"cache_write":0.0,"cache_read":0.014}}'

# ---- Database ---------------------------------------------------------
# Matches docker-compose.yml, which exposes pgvector/pgvector:pg16 on 6432.
POSTGRES_DATABASE_URL=postgresql://postgres:dev@localhost:6432/rag
TRADING_CHECKPOINT_DB_URI=postgresql://postgres:dev@localhost:6432/rag

# ---- Embeddings -------------------------------------------------------
# 1536 dimensions, matching the vector(1536) column in the schema. Changing
# this model means a migration, not just an env edit.
EMBEDDING_MODEL="text-embedding-3-small"

# ---- Agent models -----------------------------------------------------
# Every LLM role reads its model from here. LLM_CLAUDE_MODEL is the
# project-wide default and the only required one; each role below falls
# back to it if commented out. So: change one line to move everything, or
# change one role to move just that role.
#
# See the resolved table (role, model, provider, whether it is priced):
#   uv run python -m app.infrastructure.llm.models
LLM_CLAUDE_MODEL="deepseek-v4-flash"                  # research agent loop + fundamentals
LLM_ANSWER_MODEL="deepseek-v4-flash"                  # answer generation behind POST /ask
LLM_DECOMPOSER_MODEL="deepseek-v4-flash"              # query decomposition
LLM_EXTRACTION_MODEL="deepseek-v4-flash"              # financial-metric extraction
TRADING_NEWS_DIGEST_MODEL="deepseek-v4-flash"         # news digest
TRADING_TECHNICAL_MODEL="deepseek-v4-flash"           # technical-indicator interpretation
TRADING_DEBATE_MODEL="deepseek-v4-flash"              # bull/bear debate turns
TRADING_RISK_MODEL="deepseek-v4-flash"                # risk panel personas
TRADING_RESEARCH_MANAGER_MODEL="deepseek-v4-flash"    # research manager synthesis
TRADING_RISK_JUDGE_MODEL="deepseek-v4-flash"          # risk judge, final verdict
# -----------------------------------------------------------------------

# ---- SEC EDGAR --------------------------------------------------------
# SEC requires a real contact identity on every request and rate-limits to
# ~8 req/sec. Put your own name and email here.
EDGAR_USER_AGENT="Your Name you@example.com"

# Local API hardening (app/main.py).
# APP_API_KEY: when set, /ask, /extract, /ingest, /news-assess and
# /trading/analyze require a matching X-API-Key header; the research agent
# sends it automatically. Leave unset for a server only you can reach.
# APP_API_KEY=
# CORS_ALLOW_ORIGINS: browser origins allowed to call the API. Default is the
# Vite dev server (http://localhost:5173,http://127.0.0.1:5173).
# CORS_ALLOW_ORIGINS=
EDGAR_CACHE_DIR=./data/edgar-cache

# ---- Research agent ---------------------------------------------------
# Read at import in app/agent/researcher.py, which is imported by
# fundamentals_port -> nodes -> graph. Missing values fail the ENTIRE
# trading CLI with a bare KeyError before argument parsing.
LOOP_MAX_TURNS="45"   # 12-item checklist plus pre-analysis filing checks; see ANALYST_SYSTEM_PROMPT
MEMO_DIR="memos"      # vault directory for saved artifacts, resolved relative to $HOME

# Retrieval budget for the agent's ask_edgar tool. Defaults shown; the call
# cap exists because an unbounded checklist is unbounded cost per run.
# ASK_EDGAR_MAX_CALLS=30
# ASK_EDGAR_K=8
# How many of one turn's tool calls run at once. Wall clock, not cost, is
# the binding constraint on a run; the budget is re-checked before each
# wave, so an overshoot is bounded by one wave rather than one turn. Set 1
# for the old one-at-a-time behaviour.
# AGENT_TOOL_CONCURRENCY=4

# Where the cost log is written. Defaults to docs/ inside the repository —
# resolved from the code, not the working directory, so a run started
# elsewhere still writes where log_run_summary reads. One file per month.
# COST_LOG_DIR=docs

# ---- Development only -------------------------------------------------
# Read the cached fundamentals report instead of running the agent. The
# cache keys on (ticker, --as-of), so it can no longer pair an August memo
# with a March analysis date — but it is still keyed on neither the model
# nor the prompt version, so a cached report can predate either.
# MOCK_FUNDAMENTALS=1

# Forced-failure hooks for the resume tests: kill the process at a given
# turn to verify the checkpoint resumes at exactly the turn in flight.
# Leave unset for normal runs.
# DEBATE_CRASH_AT_TURN=2
# DEBATE_CRASH_WHEN=before      # "before" | "after"
# RISK_CRASH_AT_TURN=4
# RISK_CRASH_WHEN=before        # "before" | "after"
# SYNTHESIS_CRASH_AT=research   # "research" | "risk_judge"
